*.py[cod]
*.pickle
*.egg-info/
.venv/
venv/
env/

# Node / Vercel
node_modules/
.vercel/
.next/
out/

# IDE / editores
.idea/
.vscode/
*.swp

# SO / utilitários
.DS_Store
Thumbs.db

